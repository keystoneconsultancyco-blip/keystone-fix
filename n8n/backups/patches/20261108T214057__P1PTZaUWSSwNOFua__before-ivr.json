      {
        "parameters": {
          "jsCode": "const config = $input.item.json;\nconst body = $('Gather Result').item.json.body || {};\nreturn [{ json: {\n  ...config,\n  digits: body.Digits,\n  callerNumber: body.From,\n  calledNumber: body.To,\n} }];"
