                "id": "vapi-twiml",
                "name": "twiml",
                "type": "string",
                "value": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Dial answerOnBridge=\"true\" action=\"https://keystoneconsultancy.app.n8n.cloud/webhook/twilio/vapi-dial-status\" method=\"POST\">\n    <Sip>\n      sip:{{ $json.calledNumber }}@{{ $json.vapiSipCredentialId }}.{{ $json.vapiSipRegionHost }}\n      <Parameter name=\"clientId\" value=\"{{ $json.clientId }}\" />\n      <Parameter name=\"callerNumber\" value=\"{{ $json.callerNumber }}\" />\n    </Sip>\n  </Dial>\n</Response>"
              }
            ]
          },
          "options": {}
        },
        "id": "set-vapi-twiml",
        "name": "Build Vapi Handoff TwiML",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          80,
          480
        ],
        "notes": "REQUIRES VALIDATION IN TESTING: dynamic <Dial><Sip> handoff mid-call to Vapi's SIP trunking URI. Set up the SIP trunking phone number + credential in the Vapi dashboard first (see README). The Dial's action callback (Dial Status Callback node below) catches a failed handoff (busy/no-answer/failed/canceled) and falls back to forwarding the caller to reception instead of dropping the call, plus emails the business with the specific DialCallStatus so a failure is never silent."
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "fallback-twiml",
                "name": "twiml",
                "type": "string",
                "value": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say voice=\"Polly.Joanna\">Sorry, I didn't get a valid response. Goodbye.</Say>\n</Response>"
              }
            ]
          },
          "options": {}
        },
