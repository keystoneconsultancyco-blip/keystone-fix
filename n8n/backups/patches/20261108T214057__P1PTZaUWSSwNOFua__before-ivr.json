        "id": "set-merge-context",
        "name": "Merge Call Context",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -420,
          480
        ],
        "notes": "Combines the Client Config output with the caller's raw Twilio params (available via $('Gather Result')) since Execute Workflow replaces the item's json. Was a Set node that only kept digits/callerNumber/calledNumber and silently dropped every Client Config field (receptionForwardNumber, vapiSipCredentialId, vapiSipRegionHost, clientId, etc) - converted to a Code node with an explicit spread so the Vapi handoff SIP URI and reception forwarding actually get real values instead of resolving to empty strings."
      },
      {
        "parameters": {
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": {
                    "caseSensitive": true,
                    "leftValue": "",
                    "typeValidation": "strict"
                  },
                  "conditions": [
                    {
                      "leftValue": "={{ $json.digits }}",
                      "rightValue": "1",
                      "operator": {
                        "type": "string",
                        "operation": "equals"
                      }
                    }
                  ],
                  "combinator": "and"
                },
                "renameOutput": true,
                "outputKey": "Press 1 - Reception"
              },
              {
                "conditions": {
                  "options": {
                    "caseSensitive": true,
                    "leftValue": "",
                    "typeValidation": "strict"
                  },
                  "conditions": [
                    {
                      "leftValue": "={{ $json.digits }}",
                      "rightValue": "2",
                      "operator": {
                        "type": "string",
                        "operation": "equals"
                      }
                    }
                  ],
                  "combinator": "and"
                },
                "renameOutput": true,
                "outputKey": "Press 2 - AI Booking"
              }
            ]
          },
          "options": {
            "fallbackOutput": "extra"
          }
        },
