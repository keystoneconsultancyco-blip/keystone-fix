# Only these four values live in environment variables. Every other credential
# (Anthropic key, Telegram token, Moodle login, Google OAuth) is entered on the
# dashboard Setup page and stored encrypted in the database.

# Postgres connection string (Railway fills this in for you).
DATABASE_URL=postgres://postgres@localhost:5432/bilalos

# 32-byte key used to encrypt secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change it after setup, or stored secrets become unreadable.
MASTER_KEY=

# Public HTTPS address of the dashboard, e.g. https://bilal-os.up.railway.app
APP_URL=http://localhost:3000

# Where downloaded files and browser sessions are stored (Railway volume mount).
DATA_DIR=./data
