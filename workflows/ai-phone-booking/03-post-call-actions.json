{
  "name": "[Stock] Phone Booking - 3. Post-Call Actions",
  "nodes": [
    {
      "parameters": {
        "content": "## Stage 3: Post-Call Actions\nFires once, after the AI call ends, from Vapi's \"End of Call Report\" server message.\n\nIn the Vapi Assistant config:\n- Server URL -> https://n8n-production-f071.up.railway.app/webhook/vapi/end-of-call\n- Server Messages -> enable ONLY \"end-of-call-report\"\n- Analysis Plan -> add a structured data schema so the assistant extracts: bookingMade (bool), customerName, customerPhone, customerEmail, service, date, time. This is what \"Extract Call Summary\" below reads.\n\nIf bookingMade is true: sends the customer a confirmation email and the business a new-booking notification, both via the Resend HTTP API (NOT SMTP - Railway blocks outbound SMTP, so these are plain HTTPS calls instead). Requires a \"Resend API\" Header Auth credential in n8n with header 'Authorization: Bearer <resend-api-key>', same pattern as the Vapi credential.",
        "height": 320,
        "width": 460
      },
      "id": "postcall-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1100,
        -280
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi/end-of-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-end-of-call",
      "name": "Vapi End Of Call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1100,
        160
      ],
      "webhookId": "vapi-end-of-call"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "booking-made",
              "name": "bookingMade",
              "type": "boolean",
              "value": "={{ $json.body.message.analysis?.structuredData?.bookingMade === true }}"
            },
            {
              "id": "customer-name",
              "name": "customerName",
              "type": "string",
              "value": "={{ $json.body.message.analysis?.structuredData?.customerName || 'there' }}"
            },
            {
              "id": "customer-phone",
              "name": "customerPhone",
              "type": "string",
              "value": "={{ $json.body.message.analysis?.structuredData?.customerPhone || $json.body.message.customer?.number || '' }}"
            },
            {
              "id": "customer-email",
              "name": "customerEmail",
              "type": "string",
              "value": "={{ $json.body.message.analysis?.structuredData?.customerEmail || '' }}"
            },
            {
              "id": "booked-service",
              "name": "service",
              "type": "string",
              "value": "={{ $json.body.message.analysis?.structuredData?.service || '' }}"
            },
            {
              "id": "booked-date",
              "name": "bookingDate",
              "type": "string",
              "value": "={{ $json.body.message.analysis?.structuredData?.date || '' }}"
            },
            {
              "id": "booked-time",
              "name": "bookingTime",
              "type": "string",
              "value": "={{ $json.body.message.analysis?.structuredData?.time || '' }}"
            },
            {
              "id": "call-transcript",
              "name": "transcript",
              "type": "string",
              "value": "={{ $json.body.message.transcript || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-extract-summary",
      "name": "Extract Call Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -860,
        160
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_CLIENT_CONFIG_WORKFLOW_ID",
          "mode": "id"
        },
        "options": {}
      },
      "id": "exec-client-config",
      "name": "Get Client Config",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -620,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Extract Call Summary').item.json.bookingMade }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-booking-made",
      "name": "Was A Booking Made?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -380,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.confirmationFromEmail, to: [$('Extract Call Summary').item.json.customerEmail], subject: `Your booking with ${$json.businessName} is confirmed`, text: `Hi ${$('Extract Call Summary').item.json.customerName},\\n\\nYour ${$('Extract Call Summary').item.json.service} appointment with ${$json.businessName} is confirmed for ${$('Extract Call Summary').item.json.bookingDate} at ${$('Extract Call Summary').item.json.bookingTime}.\\n\\nIf you need to change or cancel, just call us back.\\n\\nThanks,\\n${$json.businessName}` }) }}",
        "options": {}
      },
      "id": "email-customer-confirmation",
      "name": "Email Customer Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -140,
        60
      ],
      "notes": "Resend API - POST /emails. Requires a Header Auth credential named 'Resend API' with header Authorization: Bearer <resend-api-key>.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_RESEND_CREDENTIAL_ID",
          "name": "Resend API - REPLACE_WITH_CLIENT_NAME"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.confirmationFromEmail, to: [$json.businessNotificationEmail], subject: `New booking: ${$('Extract Call Summary').item.json.customerName} - ${$('Extract Call Summary').item.json.bookingDate}`, text: `New booking taken by the AI phone assistant:\\n\\nCustomer: ${$('Extract Call Summary').item.json.customerName}\\nPhone: ${$('Extract Call Summary').item.json.customerPhone}\\nEmail: ${$('Extract Call Summary').item.json.customerEmail}\\nService: ${$('Extract Call Summary').item.json.service}\\nDate: ${$('Extract Call Summary').item.json.bookingDate}\\nTime: ${$('Extract Call Summary').item.json.bookingTime}` }) }}",
        "options": {}
      },
      "id": "email-business-notification",
      "name": "Email Business Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -140,
        260
      ],
      "notes": "Resend API - POST /emails. Requires a Header Auth credential named 'Resend API' with header Authorization: Bearer <resend-api-key>.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_RESEND_CREDENTIAL_ID",
          "name": "Resend API - REPLACE_WITH_CLIENT_NAME"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true } }}",
        "options": {}
      },
      "id": "respond-ack",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        140,
        160
      ]
    }
  ],
  "connections": {
    "Vapi End Of Call": {
      "main": [
        [
          {
            "node": "Extract Call Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Call Summary": {
      "main": [
        [
          {
            "node": "Get Client Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Client Config": {
      "main": [
        [
          {
            "node": "Was A Booking Made?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Was A Booking Made?": {
      "main": [
        [
          {
            "node": "Email Customer Confirmation",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Business Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Customer Confirmation": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Business Notification": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateId": "keystone-ai-phone-booking-post-call-actions"
  }
}
