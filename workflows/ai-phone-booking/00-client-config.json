              "type": "string",
              "value": "REPLACE_WITH_VAPI_SIP_CREDENTIAL_ID"
            },
            {
              "id": "vapi-sip-region-host",
              "name": "vapiSipRegionHost",
              "type": "string",
              "value": "sip.vapi.ai"
            },
            {
              "id": "vapi-assistant-id",
              "name": "vapiAssistantId",
              "type": "string",
              "value": "REPLACE_WITH_VAPI_ASSISTANT_ID"
            },
            {
