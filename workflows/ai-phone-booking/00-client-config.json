              "value": "=[{ \"name\": \"General Consultation\", \"durationMinutes\": 30 }, { \"name\": \"Follow-up\", \"durationMinutes\": 15 }]"
            },
            {
              "id": "confirmation-from-email",
              "name": "confirmationFromEmail",
